---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CalculatorGrid from '../components/CalculatorGrid.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import { CALCULATORS, HUBS, getHub, type HubSlug } from '../data/calculators';
import { getFeaturedImage } from '../data/images';
import { LOGO_URL, SITE_NAME, SITE_URL, TWITTER_URL } from '../data/site';

interface Props {
  /** Hub to list; omit on the homepage to list every hub. */
  hub?: HubSlug;
  /** Imported WordPress page providing prose and the default <title>. */
  contentSlug: string;
  h1: string;
  description: string;
  intro: string;
  faqs: FaqItem[];
}

const { hub, contentSlug, h1, description, intro, faqs } = Astro.props;
const imported = await getEntry('pages', contentSlug);
const Prose = imported ? (await render(imported)).Content : null;
const title = imported?.data.seoTitle ?? `${h1} - ${SITE_NAME}`;
const url = new URL(Astro.url.pathname, SITE_URL).href;
const sections = hub ? [{ hub: getHub(hub), items: CALCULATORS.filter((c) => c.hub === hub) }] : HUBS.map((h) => ({ hub: h, items: CALCULATORS.filter((c) => c.hub === h.slug) }));
const listed = sections.flatMap((s) => s.items);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: h1,
    url,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: listed.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${SITE_URL}/${c.slug}/` })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  ...(hub
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: getHub(hub).name, item: url },
        ],
      }]
    : [
        { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/` },
        { '@context': 'https://schema.org', '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/`, logo: LOGO_URL, sameAs: [TWITTER_URL] },
      ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} image={getFeaturedImage(contentSlug)}>
  {hub && <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: getHub(hub).name }]} />}
  <header class:list={['max-w-[70ch]', hub ? 'mt-3' : 'mt-4']}>
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{h1}</h1>
    <p class="mt-3 text-lg text-gray-600">{intro}</p>
  </header>

  {!hub && (
    <nav aria-label="Jump to a category" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {sections.map((s) => (
          <li><a href={`#hub-${s.hub.slug}`} class="inline-block rounded-full border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 no-underline hover:border-brand-600 hover:text-brand-700">{s.hub.navLabel}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {sections.map((s) => (
    <section class:list={[hub ? 'mt-8' : 'mt-14 scroll-mt-6']} id={hub ? undefined : `hub-${s.hub.slug}`} aria-labelledby={`hub-${s.hub.slug}-heading`}>
      {hub ? (
        <h2 id={`hub-${s.hub.slug}-heading`} class="sr-only">All {s.hub.name.toLowerCase()}</h2>
      ) : (
        <div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-1 border-b border-gray-200 pb-3">
          <div>
            <h2 id={`hub-${s.hub.slug}-heading`} class="text-2xl font-bold text-gray-900">{s.hub.name}</h2>
            <p class="mt-1 text-gray-600">{s.hub.blurb}</p>
          </div>
          <a href={`/${s.hub.slug}/`} class="text-sm font-semibold">All {s.items.length} {s.hub.name.toLowerCase()} <span aria-hidden="true">→</span></a>
        </div>
      )}
      <CalculatorGrid calculators={s.items} />
    </section>
  ))}

  <AdSlot />

  {Prose && (
    <article class="prose prose-gray">
      <Prose />
    </article>
  )}

  <Faq items={faqs} />
</BaseLayout>
