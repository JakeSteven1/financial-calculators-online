---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/calculator-logo-trimmed.png';
import { HUBS, hubForPath } from '../data/calculators';
import type { SiteImage } from '../data/images';
import { ADSENSE_CLIENT, LOGO_URL, SITE_NAME, SITE_URL, TWITTER_HANDLE, TWITTER_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects rendered as application/ld+json. */
  jsonLd?: object[];
  /** Social share image; defaults to the logo. */
  image?: SiteImage;
}

const { title, description, jsonLd = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const year = new Date().getFullYear();
// Social cards want a JPEG or PNG no wider than 1200px; WebP is not read everywhere.
const og = image
  ? await getImage({ src: image.src, width: Math.min(1200, image.src.width), format: 'jpeg', quality: 82 }).then((img) => ({
      url: new URL(img.src, SITE_URL).href,
      width: img.attributes.width as number,
      height: img.attributes.height as number,
      type: 'image/jpeg',
      alt: image.alt,
    }))
  : { url: LOGO_URL, width: 512, height: 512, type: 'image/png', alt: `${SITE_NAME} logo: a sketch of a calculator` };
// Wide images get the large card; the square logo fallback reads better as a small one.
const twitterCard = og.width >= og.height * 1.3 ? 'summary_large_image' : 'summary';
const activeHub = hubForPath(Astro.url.pathname);
const navItems = HUBS.map((hub) => ({
  ...hub,
  href: `/${hub.slug}/`,
  active: hub.slug === activeHub,
  // The hub page itself is the current page; on a calculator the hub is the current section.
  current: hub.slug === activeHub ? (Astro.url.pathname === `/${hub.slug}/` ? ('page' as const) : ('true' as const)) : undefined,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:type" content={og.type} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />
    <meta name="twitter:image:alt" content={og.alt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold leading-tight text-gray-900 no-underline">
          <Image src={logo} alt="" height={40} densities={[1, 2]} loading="eager" class="h-10 w-auto" />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Calculator categories" class="hidden md:block">
          <ul class="flex gap-1 text-sm font-medium">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current}
                  class:list={['block rounded-md px-3 py-2 no-underline', item.active ? 'bg-brand-50 text-brand-800' : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900']}
                >{item.navLabel}</a>
              </li>
            ))}
          </ul>
        </nav>
        <details class="site-menu relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M2 4h12M2 8h12M2 12h12" /></svg>
            Menu
          </summary>
          <nav aria-label="Calculator categories" class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-gray-200 bg-white p-2 shadow-lg">
            <ul class="text-base">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current}
                    class:list={['block rounded-md px-3 py-2 no-underline', item.active ? 'bg-brand-50 font-semibold text-brand-800' : 'text-gray-700 hover:bg-gray-100']}
                  >{item.navLabel}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 pt-6 pb-8 sm:pt-8">
      <slot />
    </main>
    <footer class="mt-16 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-[2fr_1fr_1fr]">
        <div>
          <a href="/" class="flex items-center gap-2 font-bold text-gray-900 no-underline">
            <Image src={logo} alt="" height={32} densities={[1, 2]} class="h-8 w-auto" />
            <span>{SITE_NAME}</span>
          </a>
          <p class="mt-3 max-w-xs">Free calculators for money, business, home, and statistics. For information only; not financial advice.</p>
        </div>
        <nav aria-label="Footer: calculator categories">
          <h2 class="font-semibold text-gray-900">Calculators</h2>
          <ul class="mt-3 space-y-2">
            {HUBS.map((hub) => <li><a href={`/${hub.slug}/`} class="text-gray-600 no-underline hover:text-brand-700 hover:underline">{hub.name}</a></li>)}
          </ul>
        </nav>
        <div>
          <h2 class="font-semibold text-gray-900">About</h2>
          <ul class="mt-3 space-y-2">
            <li><a href="/privacy-policy-2/" class="text-gray-600 no-underline hover:text-brand-700 hover:underline">Privacy Policy</a></li>
            <li>
              <a href={TWITTER_URL} rel="me" class="inline-flex items-center gap-2 text-gray-600 no-underline hover:text-brand-700" aria-label={`Follow ${TWITTER_HANDLE} on X (Twitter)`}>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                <span>{TWITTER_HANDLE}</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-200">
        <p class="mx-auto max-w-5xl px-4 py-4 text-gray-500">&copy; {year} {SITE_NAME}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
