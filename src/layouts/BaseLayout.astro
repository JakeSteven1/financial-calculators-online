---
import '../styles/global.css';
import { HUBS } from '../data/calculators';
import { ADSENSE_CLIENT, SITE_NAME, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects rendered as application/ld+json. */
  jsonLd?: object[];
}

const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="text-lg font-bold text-brand-800 no-underline">{SITE_NAME}</a>
        <nav aria-label="Calculator categories">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {HUBS.map((hub) => (
              <li><a href={`/${hub.slug}/`} class="text-slate-600 no-underline hover:text-brand-700">{hub.navLabel}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white text-sm text-slate-500">
      <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-4 px-4 py-6">
        <p>&copy; {year} {SITE_NAME}. For informational purposes only; not financial advice.</p>
        <ul class="flex flex-wrap gap-4">
          {HUBS.map((hub) => <li><a href={`/${hub.slug}/`} class="text-slate-500">{hub.name}</a></li>)}
          <li><a href="/privacy-policy-2/" class="text-slate-500">Privacy Policy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
