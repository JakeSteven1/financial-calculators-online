---
import '../styles/global.css';
import { HUBS, hubForPath } from '../data/calculators';
import { ADSENSE_CLIENT, SITE_NAME, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects rendered as application/ld+json. */
  jsonLd?: object[];
}

const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const year = new Date().getFullYear();
const activeHub = hubForPath(Astro.url.pathname);
const navItems = HUBS.map((hub) => ({
  ...hub,
  href: `/${hub.slug}/`,
  active: hub.slug === activeHub,
  // The hub page itself is the current page; on a calculator the hub is the current section.
  current: hub.slug === activeHub ? (Astro.url.pathname === `/${hub.slug}/` ? ('page' as const) : ('true' as const)) : undefined,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-3">
        <a href="/" class="text-lg font-bold text-brand-800 no-underline">{SITE_NAME}</a>
        <nav aria-label="Calculator categories" class="hidden md:block">
          <ul class="flex gap-1 text-sm font-medium">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current}
                  class:list={['block rounded-md px-3 py-2 no-underline', item.active ? 'bg-brand-50 text-brand-800' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900']}
                >{item.navLabel}</a>
              </li>
            ))}
          </ul>
        </nav>
        <details class="site-menu relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M2 4h12M2 8h12M2 12h12" /></svg>
            Menu
          </summary>
          <nav aria-label="Calculator categories" class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
            <ul class="text-base">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current}
                    class:list={['block rounded-md px-3 py-2 no-underline', item.active ? 'bg-brand-50 font-semibold text-brand-800' : 'text-slate-700 hover:bg-slate-100']}
                  >{item.navLabel}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white text-sm text-slate-500">
      <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-4 px-4 py-6">
        <p>&copy; {year} {SITE_NAME}. For informational purposes only; not financial advice.</p>
        <ul class="flex flex-wrap gap-4">
          {HUBS.map((hub) => <li><a href={`/${hub.slug}/`} class="text-slate-500">{hub.name}</a></li>)}
          <li><a href="/privacy-policy-2/" class="text-slate-500">Privacy Policy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
