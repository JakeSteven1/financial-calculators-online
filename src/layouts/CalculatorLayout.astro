---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { getCalculator, getHub } from '../data/calculators';
import { getRelated } from '../data/related';
import { getFeaturedImage } from '../data/images';
import { SITE_NAME, SITE_URL } from '../data/site';

interface Props {
  slug: string;
  /** Meta description (<= ~160 chars). */
  description: string;
  h1: string;
  /** Overrides the <title>; defaults to the original WordPress SEO title. */
  title?: string;
  faqs: FaqItem[];
  /** Heading for the formula slot. */
  formulaHeading?: string;
}

const { slug, description, h1, title: titleOverride, faqs, formulaHeading = "How it's calculated" } = Astro.props;
const calc = getCalculator(slug);
const hub = getHub(calc.hub);
const imported = await getEntry('pages', slug);
const Prose = imported ? (await render(imported)).Content : null;
const title = titleOverride ?? imported?.data.seoTitle ?? `${calc.name} - ${SITE_NAME}`;
const url = `${SITE_URL}/${slug}/`;
const related = getRelated(slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calc.name,
    url,
    description,
    applicationCategory: calc.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: hub.name, item: `${SITE_URL}/${hub.slug}/` },
      { '@type': 'ListItem', position: 3, name: calc.name, item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} image={getFeaturedImage(slug)}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: hub.name, href: `/${hub.slug}/` }, { label: calc.name }]} />
  <header class="mt-3 max-w-[70ch]">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{h1}</h1>
    <p class="mt-3 text-lg text-gray-600">{description}</p>
  </header>

  <div class="mt-8">
    <slot />
  </div>

  <section class="prose prose-gray mt-12" aria-labelledby="formula-heading">
    <h2 id="formula-heading">{formulaHeading}</h2>
    <slot name="formula" />
  </section>

  <AdSlot />

  {Prose && (
    <article class="prose prose-gray">
      <Prose />
    </article>
  )}

  <Faq items={faqs} />

  <AdSlot size="rectangle" />

  <RelatedCalculators calculators={related} hub={hub} />
</BaseLayout>
