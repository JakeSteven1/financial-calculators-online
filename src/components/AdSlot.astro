---
// Fixed-height ad container: the box is reserved before the ad loads, so ads
// never cause layout shift. Heights are per breakpoint and must not change.
import { ADSENSE_CLIENT } from '../data/site';

interface Props {
  /** AdSense ad unit ID (data-ad-slot). Empty renders a reserved placeholder. */
  slot?: string;
  size?: 'banner' | 'rectangle';
  class?: string;
}

const { slot = '', size = 'banner', class: className = '' } = Astro.props;
const heights = size === 'rectangle' ? 'h-[280px]' : 'h-[100px] md:h-[90px]';
const live = Boolean(ADSENSE_CLIENT && slot);
---

<div class:list={['my-12 flex w-full items-center justify-center overflow-hidden', heights, className]} data-ad-slot-container>
  {live ? (
    <>
      <ins
        class="adsbygoogle block h-full w-full"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-full-width-responsive="false"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </>
  ) : (
    <div class="h-full w-full rounded-lg bg-gray-50" />
  )}
</div>
