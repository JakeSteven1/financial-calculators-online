---
import type { CalculatorEntry } from '../data/calculators';

interface Props {
  calculators: CalculatorEntry[];
}

const { calculators } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {calculators.map((c) => (
    <li>
      <a href={`/${c.slug}/`} class="block h-full rounded-lg border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-brand-600 hover:shadow">
        <span class="font-semibold text-brand-800">{c.name}</span>
        <span class="mt-1 block text-sm text-slate-600">{c.blurb}</span>
      </a>
    </li>
  ))}
</ul>
