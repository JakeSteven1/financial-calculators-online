---
import type { CalculatorEntry } from '../data/calculators';

interface Props {
  calculators: CalculatorEntry[];
}

const { calculators } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {calculators.map((c) => (
    <li>
      <a href={`/${c.slug}/`} class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-4 no-underline transition hover:border-brand-600 hover:shadow-md">
        <span class="font-semibold text-gray-900 group-hover:text-brand-700">{c.name}</span>
        <span class="mt-1 text-sm text-gray-600">{c.blurb}</span>
      </a>
    </li>
  ))}
</ul>
