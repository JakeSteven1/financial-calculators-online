---
import type { CalculatorEntry, Hub } from '../data/calculators';

interface Props {
  calculators: CalculatorEntry[];
  hub: Hub;
}

const { calculators, hub } = Astro.props;
---

<section class="mt-12" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-2xl font-bold text-slate-900">Related calculators</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {calculators.map((c) => (
      <li>
        <a href={`/${c.slug}/`} class="block h-full rounded-lg border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-brand-600 hover:shadow">
          <span class="font-semibold text-brand-800">{c.name}</span>
          <span class="mt-1 block text-sm text-slate-600">{c.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-sm"><a href={`/${hub.slug}/`}>Browse all {hub.name.toLowerCase()}</a></p>
</section>
