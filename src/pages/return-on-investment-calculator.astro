---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import RoiCalculator from '../components/calculators/RoiCalculator';

const faqs = [
  {
    q: 'How do you calculate ROI?',
    a: 'ROI = (final value − amount invested) ÷ amount invested × 100. Investing $10,000 that grows to $15,000 is a 50% ROI.',
  },
  {
    q: 'What is annualized ROI?',
    a: 'The yearly rate that would produce the same total return: (final ÷ initial)^(1 ÷ years) − 1. A 50% return over 3 years is 14.47% a year, which lets you compare investments held for different lengths of time.',
  },
  {
    q: 'Should I include dividends and fees?',
    a: 'Yes. Add dividends, interest, and other income to the final value, and include fees and commissions in the amount invested, to get your true return.',
  },
  {
    q: 'What is a good ROI?',
    a: 'It depends on risk and time. The US stock market has returned roughly 10% a year on average over the long run before inflation; safer investments like bonds and savings accounts return less.',
  },
];
---

<CalculatorLayout
  slug="return-on-investment-calculator"
  h1="Return on Investment (ROI) Calculator"
  description="Calculate return on investment from the amount invested and final value, including dividends, plus the annualized return for your holding period."
  faqs={faqs}
>
  <RoiCalculator client:visible />
  <Fragment slot="formula">
    <ul>
      <li><strong>ROI</strong> = (final value − initial investment) ÷ initial investment × 100</li>
      <li><strong>Annualized ROI</strong> = (final value ÷ initial investment)<sup>1/years</sup> − 1</li>
    </ul>
  </Fragment>
</CalculatorLayout>
