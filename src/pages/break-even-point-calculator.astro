---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import BreakEvenCalculator from '../components/calculators/BreakEvenCalculator';

const faqs = [
  {
    q: 'What is the break-even point?',
    a: 'The sales volume at which total revenue equals total costs, so profit is exactly zero. Every unit sold beyond it adds profit equal to its contribution margin.',
  },
  {
    q: 'What is the break-even formula?',
    a: 'Break-even units = fixed costs ÷ (price per unit − variable cost per unit). With $10,000 of fixed costs, a $50 price, and a $30 variable cost, you break even at 500 units, or $25,000 in sales.',
  },
  {
    q: 'What is contribution margin?',
    a: 'Price minus variable cost per unit. It is the amount each sale contributes toward covering fixed costs and then toward profit.',
  },
  {
    q: 'How do I include a profit target?',
    a: 'Add the target to fixed costs: units = (fixed costs + target profit) ÷ contribution margin. Enter it in the profit goal field.',
  },
];
---

<CalculatorLayout
  slug="break-even-point-calculator"
  h1="Break-Even Point Calculator"
  description="Free break-even calculator. Enter fixed costs, price, and variable cost per unit to find break-even units and revenue, or the sales needed for a profit goal."
  faqs={faqs}
>
  <BreakEvenCalculator client:visible />
  <Fragment slot="formula">
    <ul>
      <li><strong>Contribution margin</strong> = price per unit − variable cost per unit</li>
      <li><strong>Break-even units</strong> = (fixed costs + profit goal) ÷ contribution margin</li>
      <li><strong>Break-even revenue</strong> = break-even units × price per unit</li>
    </ul>
    <p>Units are rounded up because you can’t sell a fraction of a unit.</p>
  </Fragment>
</CalculatorLayout>
