---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'privacy-policy-2');
if (!entry) throw new Error('Missing privacy policy content');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.seoTitle}
  description="How Free Financial Calculator Online handles your information, including cookies, advertising partners, and your privacy rights."
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Privacy Policy</h1>
  <article class="prose prose-slate mt-6 max-w-none">
    <Content />
  </article>
</BaseLayout>
